# Descartes Configuration
# Copy this file to .env and customize as needed

# Default harness: opencode, claude-code, codex
DESCARTES_HARNESS=opencode

# Default model (used when not specified per-category)
DESCARTES_MODEL=xai/grok-code-fast-1

# Fast model (for searchers, analyzers, validators)
DESCARTES_FAST_MODEL=xai/grok-code-fast-1

# Smart model (for builders, planners, orchestrators)
DESCARTES_SMART_MODEL=opus

# Harness-specific models
DESCARTES_OPENCODE_MODEL=xai/grok-code-fast-1
DESCARTES_CLAUDE_MODEL=opus
DESCARTES_CODEX_MODEL=gpt-5.1

# SCUD pass-through configuration (overrides SCUD's own .env)
# SCUD_PROVIDER=xai
# SCUD_MODEL=grok-code-fast-1
# SCUD_SMART_PROVIDER=claude-cli
# SCUD_SMART_MODEL=opus
# SCUD_FAST_PROVIDER=xai
# SCUD_FAST_MODEL=grok-code-fast-1
# SCUD_MAX_TOKENS=16000

# API Keys (only needed for providers you use)
# XAI_API_KEY=xai-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
